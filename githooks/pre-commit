#!/bin/bash
# Scan staged content for secrets before allowing the commit.
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks not installed; refusing to commit unscanned content." >&2
    exit 1
fi

# .gitleaks.local.toml extends the default rules with private identifiers that
# must not reach a public repository. It is itself uncommitted — the patterns
# name what they are looking for — so a checkout without it scans with the
# defaults alone.
args=()
if [ -f .gitleaks.local.toml ]; then
    args=(--config .gitleaks.local.toml)
fi

# A clean scan says so in three INF lines on every commit. Findings are logged at
# WRN and still set a nonzero exit, so warn keeps everything actionable.
exec gitleaks git --staged --no-banner --log-level warn "${args[@]}"
